{
  "name": "aria-music",
  "productName": "Aria Music",
  "version": "1.0.0",
  "description": "YouTube Music, Spotify ve diğer müzik servislerini tek bir şık arayüzde toplayan, hiçbir veri saklamayan masaüstü uygulaması.",
  "main": "main.js",
  "author": "dursuncankaymak",
  "license": "MIT",
  "scripts": {
    "start": "electron .",
    "pack": "electron-builder --win --dir",
    "dist": "electron-builder --win nsis portable",
    "dist:portable": "electron-builder --win portable"
  },
  "devDependencies": {
    "electron": "git+https://github.com/castlabs/electron-releases.git#v32.3.3+wvcus",
    "electron-builder": "^25.0.5"
  },
  "build": {
    "appId": "com.dursuncankaymak.ariamusic",
    "productName": "Aria Music",
    "electronDist": "node_modules/electron/dist",
    "electronVersion": "32.3.3",
    "files": [
      "main.js",
      "preload.js",
      "renderer/**/*",
      "assets/**/*",
      "build/icon.png"
    ],
    "win": {
      "target": [
        "nsis",
        "portable"
      ]
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true,
      "artifactName": "Aria-Music-Setup.${ext}"
    },
    "portable": {
      "artifactName": "Aria-Music-Portable.${ext}"
    }
  }
}
